{
	"name": "opaline-cli-monorepo",
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "turbo run build",
		"dev": "bun run --cwd apps/cli dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"test:integration": "turbo run test:integration",
		"verify": "bun run check-types && bun run lint && bun run test && bun run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"bun-types": "1.3.10",
		"turbo": "^2.8.9",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.3.10",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
