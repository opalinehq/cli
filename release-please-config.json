{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"include-v-in-tag": false,
	"include-component-in-tag": true,
	"tag-separator": "@",
	"bootstrap-sha": "ffb9d74e625d34b6a0d8099330c0e54f6a1b6208",
	"plugins": [
		{
			"type": "node-workspace",
			"merge": false
		}
	],
	"packages": {
		"apps/cli": {
			"release-type": "node",
			"component": "opaline-cli",
			"changelog-path": "CHANGELOG.md",
			"extra-files": [
				{
					"type": "json",
					"path": "/packages/opaline/package.json",
					"jsonpath": "$.version"
				},
				{
					"type": "json",
					"path": "/packages/opaline/package.json",
					"jsonpath": "$.dependencies['@opalinehq/cli']"
				},
				{
					"type": "json",
					"path": "/packages/rudel-alias/package.json",
					"jsonpath": "$.version"
				},
				{
					"type": "json",
					"path": "/packages/rudel-alias/package.json",
					"jsonpath": "$.dependencies['@opalinehq/cli']"
				}
			]
		}
	}
}
